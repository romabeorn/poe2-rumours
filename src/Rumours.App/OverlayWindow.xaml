<Window x:Class="Rumours.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Rumours.App"
        Title="PoE2 Rumours"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="HideWhenEmpty" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Counter" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="CounterCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,22,0" />
        </Style>
    </Window.Resources>

    <Grid>
    <ContentControl Style="{StaticResource Panel}" Width="{StaticResource PanelWidth}">
        <StackPanel>
            <Border Style="{StaticResource Plaque}">
                <TextBlock Text="{Binding VerdictText}" Foreground="{Binding VerdictBrush}" Style="{StaticResource Heading}" FontSize="22" />
            </Border>

            <StackPanel Margin="18,10,18,12">
                <TextBlock Text="{Binding Advice}" Style="{StaticResource HideWhenEmpty}" />
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"
                           Height="20" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />

                <local:IslandTable DataContext="{Binding Inspected}" Margin="0,2,0,0"
                                   Visibility="{Binding HasRows, Converter={StaticResource Visible}}" />

                <StackPanel Visibility="{Binding HasScans, Converter={StaticResource Visible}}">
                    <Rectangle Style="{StaticResource Separator}" />
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Text.CaptionScans}" Style="{StaticResource CounterCaption}" />
                        <TextBlock Grid.Column="1" Text="{Binding Text.CaptionStale}" Style="{StaticResource CounterCaption}" />
                        <TextBlock Grid.Column="2" Text="{Binding Text.CaptionIslands}" Style="{StaticResource CounterCaption}" />
                        <TextBlock Grid.Column="3" Text="{Binding Text.CaptionExpeditions}" Style="{StaticResource CounterCaption}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Scans}" Style="{StaticResource Counter}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StaleScans}" Style="{StaticResource Counter}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding IslandCount}" Style="{StaticResource Counter}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding GrandExpeditions}" Style="{StaticResource Counter}" />
                    </Grid>
                    <TextBlock Text="{Binding Completeness}" Style="{StaticResource HideWhenEmpty}"
                               Foreground="{StaticResource LabelBrush}" FontSize="12" Margin="0,3,0,0" />
                    <Rectangle Style="{StaticResource Separator}" />
                </StackPanel>

                <local:IslandTable DataContext="{Binding Survey}"
                                   Visibility="{Binding HasRows, Converter={StaticResource Visible}}" />

                <Rectangle Style="{StaticResource Separator}" Margin="0,10,0,6" />
                <TextBlock Text="{Binding Hint}" Foreground="{StaticResource DimBrush}" FontSize="12" HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>
    </ContentControl>

    <Border x:Name="MoveCue" Visibility="Collapsed" Background="#A6000000" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
            Cursor="SizeAll" MouseLeftButtonDown="DragStarted">
        <TextBlock x:Name="MoveCueText" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" />
    </Border>
    </Grid>
</Window>
