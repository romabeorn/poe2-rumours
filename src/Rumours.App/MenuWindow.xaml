<local:PoeWindow x:Class="Rumours.App.MenuWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:Rumours.App"
                 Title="PoE2 Rumours" WindowStartupLocation="CenterScreen" Topmost="True">
    <local:PoeWindow.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="MainTab" TargetType="RadioButton" BasedOn="{StaticResource PoeButton}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="22,7" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="SubTab" TargetType="RadioButton" BasedOn="{StaticResource PoeButton}">
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </local:PoeWindow.Resources>

    <StackPanel Width="{StaticResource TableWidth}">
        <StackPanel Orientation="Horizontal" Margin="-4,0,0,0">
            <RadioButton Style="{StaticResource MainTab}" Content="{Binding Text.TabIslands}" IsChecked="{Binding OnIslands}" />
            <RadioButton Style="{StaticResource MainTab}" Content="{Binding Text.TabSettings}" IsChecked="{Binding OnSettings}" />
        </StackPanel>
        <Rectangle Style="{StaticResource Separator}" Margin="0,12" />

        <StackPanel Visibility="{Binding OnIslands, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal" Margin="-4,0,0,10">
                <RadioButton Style="{StaticResource SubTab}" Content="{Binding Text.FilterAll}" IsChecked="{Binding ShowAll}" />
                <RadioButton Style="{StaticResource SubTab}" Content="{Binding Text.FilterExpeditions}" IsChecked="{Binding ShowExpeditions}" />
                <RadioButton Style="{StaticResource SubTab}" Content="{Binding Text.FilterBosses}" IsChecked="{Binding ShowBosses}" />
                <RadioButton Style="{StaticResource SubTab}" Content="{Binding Text.FilterUniques}" IsChecked="{Binding ShowUniques}" />
            </StackPanel>
            <local:IslandTable DataContext="{Binding Catalogue.Table}" />
        </StackPanel>

        <StackPanel Visibility="{Binding OnSettings, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding Text.SectionLanguage}" Style="{StaticResource Section}" />
            <StackPanel Orientation="Horizontal" Margin="-4,0,0,0">
                <RadioButton Content="Русский" Style="{StaticResource SubTab}" IsChecked="{Binding Russian}" />
                <RadioButton Content="English" Style="{StaticResource SubTab}" IsChecked="{Binding English}" />
            </StackPanel>

            <Rectangle Style="{StaticResource Separator}" Margin="0,12" />

            <TextBlock Text="{Binding Text.SectionAppearance}" Style="{StaticResource Section}" />
            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Text.OverlayOpacity}" VerticalAlignment="Center" Margin="0,4,16,4" />
                <Slider Grid.Column="1" Minimum="{Binding MinOpacityPercent, Mode=OneTime}" Maximum="100" SmallChange="5" LargeChange="10"
                        Style="{StaticResource PoeSlider}" Value="{Binding OpacityPercent}" />
                <TextBlock Grid.Column="2" Text="{Binding OpacityLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                <TextBlock Grid.Row="1" Text="{Binding Text.BackdropShade}" VerticalAlignment="Center" Margin="0,4,16,4" />
                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                        Style="{StaticResource PoeSlider}" Value="{Binding ShadePercent}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ShadeLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <ToggleButton Style="{StaticResource PoeButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                          Content="{Binding MoveLabel}" IsChecked="{Binding Moving}" />

            <Rectangle Style="{StaticResource Separator}" Margin="0,12" />

            <TextBlock Text="{Binding Text.SectionHotkeys}" Style="{StaticResource Section}" />
            <TextBlock Text="{Binding Text.HotkeysInstructions}" Foreground="{StaticResource LabelBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding Hotkeys}" Grid.IsSharedSizeScope="True" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="Action" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <Button x:Name="Key" Grid.Column="1" Content="{Binding Key}" Command="{Binding Rebind}"
                                    Style="{StaticResource PoeButton}" MinWidth="200" Margin="20,4,0,4" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Listening}" Value="True">
                                <Setter TargetName="Key" Property="Foreground" Value="{StaticResource ListeningBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

            <Rectangle Style="{StaticResource Separator}" Margin="0,12" />

            <DockPanel>
                <Button Style="{StaticResource PoeButton}" DockPanel.Dock="Left"
                        Content="{Binding Text.OpenLogsFolder}" Command="{Binding OpenLogs}" />
                <TextBlock Text="{Binding Version}" Foreground="{StaticResource DimBrush}" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </StackPanel>
</local:PoeWindow>
