<UserControl x:Class="Rumours.App.IslandTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <GridLength x:Key="TierColumn">40</GridLength>
        <GridLength x:Key="MapColumn">200</GridLength>
        <GridLength x:Key="KindColumn">130</GridLength>
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource TierColumn}" />
                <ColumnDefinition Width="{StaticResource MapColumn}" />
                <ColumnDefinition Width="{StaticResource KindColumn}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Text.CaptionTier}" Style="{StaticResource Caption}" />
            <TextBlock Grid.Column="1" Text="{Binding Text.CaptionMap}" Style="{StaticResource Caption}" />
            <TextBlock Grid.Column="2" Text="{Binding Text.CaptionKind}" Style="{StaticResource Caption}" />
            <TextBlock Grid.Column="3" Text="{Binding Text.CaptionReward}" Style="{StaticResource Caption}" />
        </Grid>
        <Rectangle Height="1" Fill="{StaticResource InnerFrameBrush}" Margin="0,3,0,2" />

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource TierColumn}" />
                            <ColumnDefinition Width="{StaticResource MapColumn}" />
                            <ColumnDefinition Width="{StaticResource KindColumn}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Tier}" Foreground="{Binding TierBrush}"
                                   FontWeight="Bold" FontSize="16" Margin="0,0,8,0" />

                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding Map, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold" />
                                <Run Text="{Binding NewMark, Mode=OneWay}" Foreground="{StaticResource ListeningBrush}" FontSize="12" />
                            </TextBlock>
                            <TextBlock Text="{Binding Rumour}" Foreground="{StaticResource LabelBrush}" FontStyle="Italic" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding Kind}" Foreground="{Binding KindBrush}" Margin="0,0,14,0" TextWrapping="Wrap" />

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{Binding Reward}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource FlavourBrush}" FontStyle="Italic"
                                       FontSize="12" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
