<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

    <sys:Double x:Key="PanelWidth">660</sys:Double>
    <sys:Double x:Key="TableWidth">620</sys:Double>

    <sys:Double x:Key="BackdropShade">0.5</sys:Double>

    <SolidColorBrush x:Key="TextBrush" Color="#D8CDB4" />
    <SolidColorBrush x:Key="LabelBrush" Color="#A38D6D" />
    <SolidColorBrush x:Key="DimBrush" Color="#7A6A50" />
    <SolidColorBrush x:Key="GoldBrush" Color="#E8D19A" />
    <SolidColorBrush x:Key="FlavourBrush" Color="#AF6025" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9A3C" />
    <SolidColorBrush x:Key="ListeningBrush" Color="#FFFF77" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F2C14E" />
    <SolidColorBrush x:Key="InnerFrameBrush" Color="#4D3F26" />

    <SolidColorBrush x:Key="TierTopBrush" Color="#FFB84D" />
    <SolidColorBrush x:Key="TierGoodBrush" Color="#7CD66B" />
    <SolidColorBrush x:Key="TierFairBrush" Color="#8888FF" />
    <SolidColorBrush x:Key="TierBadBrush" Color="#D94A3D" />
    <SolidColorBrush x:Key="VerdictOpenBrush" Color="#A9CC84" />
    <SolidColorBrush x:Key="VerdictSkipBrush" Color="#D9705C" />

    <RadialGradientBrush x:Key="PanelBackground" Center="0.5,0.35" RadiusX="0.9" RadiusY="0.9" GradientOrigin="0.5,0.25">
        <GradientStop Color="#F2151413" Offset="0" />
        <GradientStop Color="#F5090908" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="FrameBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8C7444" Offset="0" />
        <GradientStop Color="#4A3A1E" Offset="0.5" />
        <GradientStop Color="#9C8450" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PlaqueBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E61B1917" Offset="0" />
        <GradientStop Color="#E60B0A09" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderShade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#B3000000" Offset="0" />
        <GradientStop Color="#66000000" Offset="0.45" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderRule" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E6C9AE6E" Offset="0" />
        <GradientStop Color="#80A38D6D" Offset="0.4" />
        <GradientStop Color="#00A38D6D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SeparatorBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00A38D6D" Offset="0" />
        <GradientStop Color="#CCA38D6D" Offset="0.5" />
        <GradientStop Color="#00A38D6D" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="Separator" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <Style x:Key="Panel" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource FrameBrush}"
                            BorderThickness="2" CornerRadius="2">
                        <Grid>
                            <Canvas x:Name="Backdrop" ClipToBounds="True">
                                <Image Source="{DynamicResource PanelImage}" Stretch="Uniform" Opacity="0.97"
                                       Width="{Binding ActualWidth, ElementName=Backdrop}">
                                    <Image.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="Black" Offset="0.85" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Image.OpacityMask>
                                </Image>
                            </Canvas>
                            <Rectangle Fill="Black" Opacity="{DynamicResource BackdropShade}" />
                            <Border BorderBrush="{StaticResource InnerFrameBrush}" BorderThickness="1" Margin="3">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Plaque" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HeaderShade}" />
        <Setter Property="BorderBrush" Value="{StaticResource HeaderRule}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="18,9,18,8" />
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.9" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,18,0" />
    </Style>

    <Style x:Key="PoeButton" TargetType="ButtonBase">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="16,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Frame" Background="{StaticResource PlaqueBackground}" BorderBrush="#5C4A2A"
                            BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#C9AE6E" />
                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#C9AE6E" />
                            <Setter TargetName="Frame" Property="Background" Value="#F02B2721" />
                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PoeSlider" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="22" Background="Transparent">
                        <Border Height="4" Background="#0B0A09" BorderBrush="#5C4A2A" BorderThickness="1" CornerRadius="2" />
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="10" Height="18" Background="#C9AE6E" BorderBrush="#3A2C14"
                                                    BorderThickness="1" CornerRadius="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PoeWindow" TargetType="Window">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <ContentControl Style="{StaticResource Panel}">
                        <DockPanel>
                            <Border x:Name="PART_Header" DockPanel.Dock="Top" Style="{StaticResource Plaque}" Cursor="SizeAll">
                                <Grid>
                                    <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Heading}" Margin="0,0,40,0" />
                                    <Button x:Name="PART_Close" Content="✕" Style="{StaticResource PoeButton}" FontSize="12"
                                            Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="20,14,20,18" />
                        </DockPanel>
                    </ContentControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
